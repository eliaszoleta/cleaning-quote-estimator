PORT=3001
NODE_ENV=development
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Separate webhook secret for /api/partner-checkout/webhook -- Stripe issues
# a distinct signing secret per configured webhook endpoint, so this must be
# set up as its own endpoint in the Stripe Dashboard (not reused from
# STRIPE_WEBHOOK_SECRET above).
STRIPE_PARTNER_WEBHOOK_SECRET=
# Separate webhook secret for /api/website-request/webhook -- same reasoning
# as STRIPE_PARTNER_WEBHOOK_SECRET above (its own Stripe Dashboard endpoint,
# its own signing secret). Optional: the webhook is only a backup activation
# path (see routes/websiteRequest.js) -- the primary path, the verify-setup/
# verify-subscription routes called right after Stripe redirects the browser
# back, works without it.
STRIPE_WEBSITE_REQUEST_WEBHOOK_SECRET=
FRONTEND_URL=https://cleanestimator.com
JWT_SECRET=change_me_in_production
RESEND_API_KEY=
RESEND_FROM_EMAIL=info@cleanestimator.com
# Signing secret for Resend's delivery-event webhook (Resend Dashboard >
# Webhooks > add an endpoint pointed at
# https://<this-backend>/api/admin/email-marketing/webhook/resend, select
# the sent/delivered/bounced/opened/clicked/complained events) -- powers
# the Email Marketing tab's KPI tracking. Optional: without it, emails
# still send, they just never show delivered/bounced/opened status.
RESEND_WEBHOOK_SECRET=
# Shared secret for every /api/admin/* route (x-admin-key header) --
# protects the consolidated admin dashboard (Website Requests, Leads,
# Companies, Partners, Email Marketing tabs). Required for any of it to work.
ADMIN_API_KEY=
# Anthropic API key powering the Growth/Pro-tier AI chatbot widget (see
# routes/chatWidget.js). Get one at console.anthropic.com -- separate from
# any claude.ai chat subscription, billed per-token.
ANTHROPIC_API_KEY=
# Google service account for syncing chatbot leads to a shared Google Sheet
# (see services/chatbotSheetsSync.js). One-time setup: create a Google
# Cloud service account, enable the Sheets API, share the target sheet with
# this service account's email (Editor access), create one tab named
# "Leads" with header row Timestamp | Business | Name | Phone | Summary |
# Status | ChatbotId. GOOGLE_SHEETS_SERVICE_ACCOUNT_PRIVATE_KEY is the PEM
# key from the downloaded JSON credentials file, with real newlines
# replaced by literal \n (most .env / host dashboards can't store a
# multi-line value directly).
GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SHEETS_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=
